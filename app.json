{
  "expo": {
    "name": "family-bench",
    "slug": "family-bench",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "familybench",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Family Bench accesses the photos you choose to attach as evidence in your case.",
          "cameraPermission": "Family Bench uses the camera when you choose to capture a photo for your case."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Family Bench uses the microphone when you choose to record a voice note for your case."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
